@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="hero-banner">
    <div class="hero-background">
        <img src="~/Images/banner.png" alt="Korsten Lutheran Church" class="hero-bg-img" />
        <div class="hero-overlay"></div>
    </div>

    <div class="hero-header">
        <img src="~/images/logo.png" alt="Korsten Parish Logo" class="hero-logo" />
         
    </div>

    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">Welcome to Korsten Lutheran Church</h1>
            <p class="hero-subtitle">A community rooted in faith, hope, and love</p>
            <div class="hero-buttons">
                <a href="#" class="hero-btn primary">Join Us Sunday</a>
                <a href="#" class="hero-btn secondary">Learn More</a>
            </div>
        </div>
    </div>

    <div class="hero-info-bar">
        <div class="info-item">
            <span class="info-icon">📅</span>
            <div class="info-text">
                <strong>Sunday Service</strong>
                <span>10:00 AM</span>
            </div>
        </div>
        <div class="info-item">
            <span class="info-icon">📍</span>
            <div class="info-text">
                <strong>Visit Us</strong>
                <span>Port Elizabeth</span>
            </div>
        </div>
        <div class="info-item">
            <span class="info-icon">📞</span>
            <div class="info-text">
                <strong>Contact</strong>
                <span>Call Today</span>
            </div>
        </div>
    </div>
</div>

<br />

<section class="welcome-section">
    <div class="welcome-container">
        <div class="welcome-image">
            <img src="~/Images/emblem.png" alt="Welcome to our church" class="welcome-img" />
        </div>
        <div class="welcome-content">
            <h2 class="welcome-title">Welcome</h2>
            <h3 class="welcome-subtitle">We're glad you're here</h3>

            <p class="welcome-text">
                Jesus was a simple man with a simple plan to make God known.
                Together, we constantly look at Jesus through God's Word, inspired to
                become whatever destiny requires so that we can give hope to the
                many still unfamiliar with God's amazing love. We do this by building a
                community rooted in the Bible, fostering deep spiritual friendships,
                and doing good in our community.
            </p>

            <p class="welcome-text">
                We meet in <strong>multiple Sunday service locations</strong> across the Bay Area, and
                our <strong>small groups</strong> meet throughout the week.
            </p>

            <p class="welcome-text">
                We hope you will join us in our mission to create a non-traditional, non-denominational,
                life-changing church.
            </p>

            <a href="#" class="welcome-btn">
                <span class="btn-icon">👥</span>
                Who we are
            </a>
        </div>
    </div>
</section>


<section class="monthly-schedule-section">
    <h2 class="section-title">Monthly Schedule</h2>
    <div class="schedule-container">
        <table class="monthly-schedule-table">
            <thead>
                <tr class="schedule-header-row">
                    <th>Time</th>
                    <th>Session</th>
                    <th>Speaker</th>
                </tr>
            </thead>
            <tbody>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">9:00 AM,<br>Saturday</td>
                    <td class="schedule-session-cell">Youth Ministry Bible Study</td>
                    <td class="schedule-speaker-cell">Einat Sharon</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">10:00 AM,<br>Sunday</td>
                    <td class="schedule-session-cell">Sunday Worship Service</td>
                    <td class="schedule-speaker-cell">Pastor Johnson</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">11:00 AM,<br>Sunday</td>
                    <td class="schedule-session-cell">Adult Bible Study</td>
                    <td class="schedule-speaker-cell">Elder Matthews</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">2:00 PM,<br>Wednesday</td>
                    <td class="schedule-session-cell">Community Prayer Meeting</td>
                    <td class="schedule-speaker-cell">Sister Williams</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">6:30 PM,<br>Friday</td>
                    <td class="schedule-session-cell">Youth Gathering</td>
                    <td class="schedule-speaker-cell">Youth Pastor Davis</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>


<section class="church-gallery-section">
    <div class="gallery-container">
        <div class="gallery-header">
            <h2 class="gallery-title">Connect & Grow With Us</h2>
            <p class="gallery-subtitle">Discover the many ways to be part of our church community</p>
        </div>

        <div class="gallery-grid">
            <!-- Card 1: Sunday Services -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/IMG_1.jpeg" alt="Sunday Service" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Sunday Services</h3>
                    <p class="card-description">Join us every Sunday at 10:00 AM for inspiring worship, uplifting music, and biblical teaching that speaks to your heart and daily life.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">📅</span>
                        View Service Times
                    </a>
                </div>
            </div>

            <!-- Card 2: Small Groups -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/IMG_2.jpeg" alt="Small Groups" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Small Groups</h3>
                    <p class="card-description">Connect with friends at a similar life stage in your neighborhood. Build meaningful relationships through Bible study and fellowship.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">👥</span>
                        Find a Group
                    </a>
                </div>
            </div>

            <!-- Card 3: Youth Ministry -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/palm.png" alt="Youth Ministry" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Youth Ministry</h3>
                    <p class="card-description">Dynamic programs for teens and young adults featuring games, worship, mentorship, and life-changing discussions about faith.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">🎯</span>
                        Join Youth Group
                    </a>
                </div>
            </div>

            <!-- Card 4: Community Outreach -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/soup.png" alt="Community Outreach" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Community Outreach</h3>
                    <p class="card-description">Make a difference in Port Elizabeth through volunteer opportunities, food drives, and community service projects that show God's love.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">❤️</span>
                        Get Involved
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="events-section">
    <h2 class="section-title">Schedule of Events</h2>
    <div class="events-list">
        <div class="event-card">
            <h3 class="event-title">Sunday Worship Service</h3>
            <p class="event-time">Every Sunday at 10:00 AM</p>
            <p class="event-location">Main Sanctuary</p>
        </div>

        <div class="event-card">
            <h3 class="event-title">Bible Study</h3>
            <p class="event-time">Wednesdays at 7:00 PM</p>
            <p class="event-location">Fellowship Hall</p>
        </div>

        <div class="event-card">
            <h3 class="event-title">Youth Gathering</h3>
            <p class="event-time">Fridays at 6:30 PM</p>
            <p class="event-location">Youth Room</p>
        </div>

        <div class="event-card">
            <h3 class="event-title">Community Outreach</h3>
            <p class="event-time">1st Saturday of the Month at 9:00 AM</p>
            <p class="event-location">Community Center</p>
        </div>
    </div>
</section>



