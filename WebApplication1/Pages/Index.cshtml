@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="hero-banner">
    <div class="hero-background">
        <img src="~/Images/banner.png" alt="Korsten Lutheran Church" class="hero-bg-img" />
        <div class="hero-overlay"></div>
    </div>

    <div class="hero-header">
        <img src="~/images/logo.png" alt="Korsten Parish Logo" class="hero-logo" />
         
    </div>

    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">Welcome to Korsten Lutheran Church</h1>
            <p class="hero-subtitle">A community rooted in faith, hope, and love</p>
            <div class="hero-buttons">
                <a href="#" class="hero-btn primary">Join Us Sunday</a>
                <a asp-page="/About" class="hero-btn secondary">Learn More</a>
            </div>
        </div>
    </div>

    <div class="hero-info-bar">
        <div class="info-item">
            <span class="info-icon">📅</span>
            <div class="info-text">
                <strong>Sunday Service</strong>
                <span>9:00 AM</span>
            </div>
        </div>
        <div class="info-item">
            <span class="info-icon">📍</span>
            <div class="info-text">
                <strong>Visit Us</strong>
                <span>2 Elkana Rd, Korsten</span>
            </div>
        </div>
        <div class="info-item">
            <span class="info-icon">📞</span>
            <div class="info-text">
                <strong>Email Us</strong>
                <span>el.korsten2@gmail.com</span>
            </div>
        </div>
    </div>
</div>

<br />

<section class="welcome-section">
    <div class="welcome-container">
        <div class="welcome-image">
            <img src="~/Images/emblem.png" alt="Welcome to our church" class="welcome-img" />
        </div>
        <div class="welcome-content">
            <h2 class="welcome-title">Welcome</h2>
            <h3 class="welcome-subtitle">We're glad you're here</h3>

            <p class="welcome-text">
                Welcome to our church family. We are a Christ-centred Lutheran congregation rooted in God’s Word, guided by His grace, and committed to sharing the love of Jesus Christ with all people. Our desire is to be a place where faith grows, hope is renewed, and lives are strengthened through worship, prayer, fellowship, and service.
            </p>

            

            <p class="welcome-text">
                Whether you are visiting for the first time, searching for spiritual direction, or looking for a church to call home, you are warmly invited to join us. Here, there is a place for you to belong, to grow, and to experience God’s love in community.
            </p>

            <a href="#" class="welcome-btn">
                <span class="btn-icon">👥</span>
                Who we are
            </a>
        </div>
    </div>
</section>

<section class="home-soup-section">
    <div class="home-soup-shell">
        <div class="home-soup-copy">
            <div class="home-soup-icon" aria-hidden="true">☕</div>
            <p class="home-soup-label">Serving With Love</p>
            <h2 class="home-soup-title">Our Soup Kitchen Ministry</h2>
            <div class="home-soup-divider"></div>
            <p class="home-soup-text">
                Every meal we serve is an opportunity to share Christ's love and make a difference in our
                community. We provide warm, nutritious meals to those in need with dignity and compassion.
            </p>
            <a asp-page="/SoupKitchen" class="home-soup-button">
                <span>Learn More</span>
                <span class="home-soup-button-arrow" aria-hidden="true">→</span>
            </a>
        </div>

        <div class="home-soup-image-wrap">
            <img src="~/Images/soup_home.png" alt="Serving meals through the soup kitchen ministry" class="home-soup-image" />
        </div>
    </div>
</section>

<section class="monthly-schedule-section">
    <h2 class="section-title">Monthly Schedule</h2>
    <div class="schedule-container">
        <table class="monthly-schedule-table">
            <thead>
                <tr class="schedule-header-row">
                    <th>Time</th>
                    <th>Session</th>
                    <th>Speaker</th>
                </tr>
            </thead>
            <tbody>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">9:00 AM,<br>Saturday</td>
                    <td class="schedule-session-cell">Youth Ministry Bible Study</td>
                    <td class="schedule-speaker-cell">Einat Sharon</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">9:00 AM,<br>Sunday</td>
                    <td class="schedule-session-cell">Sunday Worship Service</td>
                    <td class="schedule-speaker-cell">Pastor Johnson</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">6:30 PM,<br>Wednesday</td>
                    <td class="schedule-session-cell">Adult Bible Study</td>
                    <td class="schedule-speaker-cell">Elder Matthews</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">2:00 PM,<br>Wednesday</td>
                    <td class="schedule-session-cell">Community Prayer Meeting</td>
                    <td class="schedule-speaker-cell">Sister Williams</td>
                </tr>
                <tr class="schedule-row">
                    <td class="schedule-time-cell">6:30 PM,<br>Friday</td>
                    <td class="schedule-session-cell">Youth Gathering</td>
                    <td class="schedule-speaker-cell">Youth Pastor Davis</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>


<section class="church-gallery-section">
    <div class="gallery-container">
        <div class="gallery-header">
            <h2 class="gallery-title">Connect & Grow With Us</h2>
            <p class="gallery-subtitle">Discover the many ways to be part of our church community</p>
        </div>

        <div class="gallery-grid">
            <!-- Card 1: Sunday Services -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/IMG_1.jpeg" alt="Sunday Service" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Sunday Services</h3>
                    <p class="card-description">Join us every Sunday at 9:00 AM for inspiring worship, uplifting music, and biblical teaching that speaks to your heart and daily life.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">📅</span>
                        View Service Times
                    </a>
                </div>
            </div>

            <!-- Card 2: Pastoral Consultations -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/congregation_3.jpeg" alt="Pastoral Consultations" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Pastoral Consultations</h3>
                    <p class="card-description">Meet with the pastor for prayer, spiritual guidance, encouragement, and pastoral care as you navigate life's questions and seasons.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">✝️</span>
                        Learn more
                    </a>
                </div>
            </div>

            <!-- Card 3: Sunday School -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/congregation_1.jpeg" alt="Sunday School" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Sunday School</h3>
                    <p class="card-description">A joyful space for children to learn Bible stories, grow in faith, sing, pray, and discover God's love in ways that are warm, simple, and age-appropriate.</p>
                    <a href="#" class="card-button">
                        <span class="button-icon">🌟</span>
                        Learn more
                    </a>
                </div>
            </div>

            <!-- Card 4: Community Outreach -->
            <div class="gallery-card">
                <div class="card-image-container">
                    <img src="~/Images/soup.png" alt="Community Outreach" class="card-image" />
                    <div class="card-overlay"></div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Community Outreach</h3>
                    <p class="card-description">Make a difference in Gqeberha through volunteer opportunities, food drives, and community service projects that show God's love.</p>
                    <a asp-page="/SoupKitchen" class="card-button">
                        <span class="button-icon">❤️</span>
                        Get Involved
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>


<section class="events-section">
    <h2 class="section-title">Schedule of Events</h2>
    <div class="events-list">
        <div class="event-card">
            <h3 class="event-title">Sunday Worship Service</h3>
            <p class="event-time">Every Sunday at 9:00 AM</p>
            <p class="event-location">Main Sanctuary</p>
        </div>

        <div class="event-card">
            <h3 class="event-title">Bible Study</h3>
            <p class="event-time">Wednesdays at 6:30 PM</p>
            <p class="event-location">Fellowship Hall</p>
        </div>

        <div class="event-card">
            <h3 class="event-title">Youth Gathering</h3>
            <p class="event-time">Fridays at 6:30 PM</p>
            <p class="event-location">Youth Room</p>
        </div>

        <div class="event-card">
            <h3 class="event-title">Community Outreach</h3>
            <p class="event-time">1st Saturday of the Month at 9:00 AM</p>
            <p class="event-location">Community Center</p>
        </div>
    </div>
</section>



