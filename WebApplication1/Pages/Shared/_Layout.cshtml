<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <button id="menuToggle" class="menu-toggle">&#9776;</button>

</head>


<body>
     

    <!-- Hidden Menu -->
    <div id="overlayMenu" class="overlay-menu">
        <div class="overlay-content-container">
            <div class="overlay-left">
                <h1>Welcome to Korsten Lutheran Church</h1>
            </div>
            <div class="overlay-right">
                <ul>
                    <li><a asp-page="/Index">Home</a></li>
                    <li><a asp-page="/About">About</a></li>
                    <li><a asp-page="/Privacy">Privacy</a></li>
                </ul>
            </div>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>


    <footer class="church-footer">
        <div class="footer-container">
            <!-- Main Footer Content -->
            <div class="footer-main">
                <div class="footer-section footer-about">
                    <div class="footer-logo">
                        <img src="~/images/logo.png" alt="Korsten Parish Logo" class="footer-logo-img" />
                        <h3 class="footer-logo-text">Korsten Lutheran Church</h3>
                    </div>
                    <p class="footer-description">
                        A community rooted in faith, hope, and love. Join us as we grow together in Christ and serve our community with open hearts.
                    </p>
                    <div class="footer-social">
                        <a href="#" class="social-link" aria-label="Facebook">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                            </svg>
                        </a>
                        <a href="#" class="social-link" aria-label="YouTube">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                            </svg>
                        </a>
                        <a href="#" class="social-link" aria-label="Instagram">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                            </svg>
                        </a>
                        <a href="#" class="social-link" aria-label="Email">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                            </svg>
                        </a>
                    </div>
                </div>

                <div class="footer-section footer-links">
                    <h4 class="footer-heading">Quick Links</h4>
                    <ul class="footer-list">
                        <li><a href="#" class="footer-link">About Us</a></li>
                        <li><a href="#" class="footer-link">Our Beliefs</a></li>
                        <li><a href="#" class="footer-link">Ministries</a></li>
                        <li><a href="#" class="footer-link">Events</a></li>
                        <li><a href="#" class="footer-link">Sermons</a></li>
                        <li><a href="#" class="footer-link">Contact</a></li>
                    </ul>
                </div>

                <div class="footer-section footer-services">
                    <h4 class="footer-heading">Service Times</h4>
                    <div class="service-item">
                        <span class="service-day">Sunday Service</span>
                        <span class="service-time">10:00 AM</span>
                    </div>
                    <div class="service-item">
                        <span class="service-day">Bible Study</span>
                        <span class="service-time">Wednesday 7:00 PM</span>
                    </div>
                    <div class="service-item">
                        <span class="service-day">Youth Group</span>
                        <span class="service-time">Friday 6:00 PM</span>
                    </div>
                    <div class="service-item">
                        <span class="service-day">Prayer Meeting</span>
                        <span class="service-time">Saturday 8:00 AM</span>
                    </div>
                </div>

                <div class="footer-section footer-contact">
                    <h4 class="footer-heading">Get in Touch</h4>
                    <div class="contact-item">
                        <span class="contact-icon">📍</span>
                        <div class="contact-info">
                            <span class="contact-label">Address</span>
                            <span class="contact-value">Korsten, Port Elizabeth<br>Eastern Cape, South Africa</span>
                        </div>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">📞</span>
                        <div class="contact-info">
                            <span class="contact-label">Phone</span>
                            <span class="contact-value">+27 (0)41 XXX-XXXX</span>
                        </div>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">✉️</span>
                        <div class="contact-info">
                            <span class="contact-label">Email</span>
                            <span class="contact-value">info@korstenlutheran.org</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <div class="footer-bottom-content">
                    <p class="footer-copyright">
                        © 2025 Korsten Lutheran Church. All rights reserved.
                    </p>
                    <div class="footer-bottom-links">
                        <a href="#" class="footer-bottom-link">Privacy Policy</a>
                        <span class="footer-divider">|</span>
                        <a href="#" class="footer-bottom-link">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>