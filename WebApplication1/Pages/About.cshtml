@page
@model KLP.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}
<div class="about-hero-banner">
    <img src="~/Images/About-page.png" alt="About Banner" class="about-banner-img" />
    <div class="about-hero-overlay"></div>
    <div class="about-hero-content">
        <h1 class="about-hero-title">About Us</h1>
        <p class="about-hero-subtitle">Discover our faith, values, and mission as we walk together in Christ</p>
    </div>
</div>

<div class="about-main-content">
    <!-- Values Section -->
    <section class="values-section">
        <div class="section-header">
            <h2 class="section-title">Our Values</h2>
            <p class="scripture-ref">Acts 2:42–47</p>
        </div>

        <div class="values-grid">
            <div class="value-card">
                <div class="value-number">1</div>
                <h3 class="value-title">Grounded in God's Word</h3>
                <p class="value-description">
                    We believe the Bible is the inspired Word of God and the foundation for all we believe and do. In hearing, studying, and teaching the Scriptures, we grow in our relationship with God and learn how to live faithfully in the world.
                    <em>(Psalm 119:105, 2 Timothy 3:16)</em>
                </p>
            </div>

            <div class="value-card">
                <div class="value-number">2</div>
                <h3 class="value-title">Saved by Grace, Through Faith</h3>
                <p class="value-description">
                    We believe we are saved not by anything we do, but purely by God's grace through faith in Jesus Christ. This is the heart of the Gospel and the foundation of the Lutheran faith.
                    <em>(Ephesians 2:8–9, Romans 3:22–24)</em>
                </p>
            </div>

            <div class="value-card">
                <div class="value-number">3</div>
                <h3 class="value-title">Empowered by the Holy Spirit</h3>
                <p class="value-description">
                    The Holy Spirit calls, gathers, enlightens, and sanctifies us. He equips us to follow Jesus daily, serve others, and bear witness to God's love in our lives.
                    <em>(Galatians 5:22–23, John 14:26)</em>
                </p>
            </div>

            <div class="value-card">
                <div class="value-number">4</div>
                <h3 class="value-title">Living in Community</h3>
                <p class="value-description">
                    We were never meant to walk this life alone. We are called into Christian community to worship together, encourage one another, and serve side by side.
                    <em>(Hebrews 10:24–25, Acts 2:44–47)</em>
                </p>
            </div>

            <div class="value-card">
                <div class="value-number">5</div>
                <h3 class="value-title">Called to Mission</h3>
                <p class="value-description">
                    Jesus sends us out to be His hands and feet in the world. We seek to live as everyday missionaries — in our homes, workplaces, and neighborhoods — making disciples of all nations.
                    <em>(Matthew 28:19–20, 2 Corinthians 5:20)</em>
                </p>
            </div>
        </div>
    </section>

    <!-- Sacraments Section -->
    <section class="sacraments-section">
        <div class="section-header">
            <h2 class="section-title">Baptism & Holy Communion</h2>
        </div>

        <div class="sacraments-grid">
            <div class="sacrament-card">
                <div class="sacrament-icon">💧</div>
                <h3 class="sacrament-title">Baptism</h3>
                <p class="sacrament-description">
                    Baptism is a sacred act in which God claims us as His own. In baptism, whether as infants or adults, we are united with Christ, adopted into God's family, and marked with the cross of Christ forever.
                    <em>(Romans 6:3–4, Titus 3:5–7)</em>
                </p>
            </div>

            <div class="sacrament-card">
                <div class="sacrament-icon">🍞</div>
                <h3 class="sacrament-title">Holy Communion</h3>
                <p class="sacrament-description">
                    In Holy Communion, we receive the true body and blood of Christ in, with, and under the bread and wine for the forgiveness of sins. All baptized believers who trust in Christ's promise are welcome to the table.
                    <em>(Luke 22:19–20, 1 Corinthians 11:23–26)</em>
                </p>
            </div>
        </div>
    </section>
</div>
